# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aipm:aipm@localhost:5432/aipm

# --- CORS (the Next.js BFF origin) ---
CORS_ORIGINS=http://localhost:3000

# --- Auth token lifetimes (minutes / days) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage ---
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=25

# --- Job queue (SAQ, Postgres backend — reuses DATABASE_URL) ---
SAQ_CONCURRENCY=4

# --- OpenAI (server-side default; per-user overrides live in ai_provider_settings) ---
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

# --- Gemini ---
GEMINI_DEFAULT_MODEL=gemini-3.5-flash

# --- Jarvis chatbot: GitHub search tool (app/agents/chat_tools.py) ---
# Optional — a shared app-level token (not per-user). Without it, github_search still
# works but degrades to GitHub's unauthenticated rate limit (10 req/min).
GITHUB_TOKEN=
GITHUB_MIN_STARS=200
GITHUB_FRESHNESS_MONTHS=12
